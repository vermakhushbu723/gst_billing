PORT=4100
MONGODB_URI=mongodb://127.0.0.1:27017/gst_billing
JWT_SECRET=change-this-to-a-long-random-string
# Public base URL of the API, used to build the WhatsApp PDF links.
# Leave empty to derive it from the incoming request.
PUBLIC_URL=
# Optional: path of the Flutter web build to serve at "/" (e.g. ../app/build/web)
WEB_DIR=
# Comma separated list of allowed web origins, or * for all
CORS_ORIGINS=*
# First admin created by `npm run seed`
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@billing.local
SEED_ADMIN_PASSWORD=admin123
